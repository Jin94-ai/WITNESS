# ============================================
# 베드로 시뮬레이터 .gitignore
# ============================================

# Claude Code
CLAUDE.local.md
.claude-cache/
.claude-temp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 환경 변수
.env
.env.local
.env.*.local

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# 테스트 & 커버리지
coverage/
htmlcov/
*.lcov

# 로그 & 임시
logs/
*.log
tmp/
temp/

# 보안
*.pem
*.key
credentials.json
secrets.json
*.secrets
.secrets/
api-keys.json

# 실험 코드 (Probe 완료 후 삭제하지만 만약을 위해)
# experiments/ 는 커밋 가능 (Probe 진행 중일 수 있음)

# 빌드
dist/
build/

# Witness 생성 파일
*.db
*.sqlite
.coverage
coverage.xml
output/
.claude/scheduled_tasks.lock

# 대용량 생성 데이터 — reproducible 이므로 repo 미포함
# (필요 시 scripts/ 로 재생성). ABC snapshots(.db) / trajectory jsonl /
# numpy array(X.npy etc) 는 전부 실험 생성물.
# git 구문: data/* 로 내용은 제외, README.md/.gitkeep 만 예외.
data/*
!data/README.md
!data/.gitkeep

# 벤치마크 아티팩트 (소스는 OK, 결과는 제외)
benchmarks/results/
*.prof

# Backup / 임시 저장
*.bak
*.orig

# 실측 산출물 중 대용량은 제외 (구조/코드만 커밋)
# 단 docs/person/v3_measurement/*.json 은 유지 (rubric 비교 소스)

# Archive — local-only legacy / superseded artifacts
# (created 2026-04-27 via WITNESS_PROJECT_DIET_ACTIONS.md Phase 2)
# README.md만 git tracked, 내용물은 로컬 한정 + 외부 백업으로 운영.
archive/*
!archive/README.md
!archive/.gitkeep

# Phase 3.0 Data Pilot — 외부 데이터 / 저작권 위험 영역
# (Phase 2.9 prep + Phase 3.0 v1.1 pipeline, 사용자 승인 후 실제 fetch 시작)
# DATA_SOURCE_CANDIDATE_REVIEW.md + PHASE_3_0_DATA_PILOT_PREP.md §6.2 참조
# 원문 synopsis: 비공개 strict
data/external_private/
data/annotation/phase3_pilot/per_annotator/
data/annotation/phase3_pilot/synopsis_cache/
# Phase 3.0 v1.1 §8.2 — annotation_inputs는 synopsis_text 포함이므로 비공개
data/annotation/phase3_pilot/annotation_inputs/
data/annotation/phase3_pilot/annotation_outputs/
data/annotation/phase3_pilot/validated/
# normalized_synopsis.jsonl도 synopsis_text 포함 → 비공개
data/annotation/phase3_pilot/normalized_synopsis.jsonl
# 단, public-safe / features / reports는 공개 가능 → 추적
!data/annotation/phase3_pilot/public_safe_dataset.jsonl
!data/annotation/phase3_pilot/features/
!data/annotation/phase3_pilot/reports/
# LLM API key / 호출 로그 — 비공개
data/llm_keys/
data/llm_call_logs/

# Models — local-only ML artifacts (Phase 3.2+ 예정, 현재 0 trained)
models/

# Visual track — frozen 2026-05-06 (per CLAUDE.md). Local HTML demos만 보존.
# (frozen sub-tracks: pixel_event_playback / world_flow_observer / dot_observer_* 등)
visual/

# Phase 3 Manual Pivot — raw synopsis (cycle 85, witness_selected_works.md)
# 자기 표현 요약본이지만 작품명 익명화 + 라이선스 안전성 위해 private 유지.
# 예외: collection_log.jsonl + _title_mapping.json은 별도 결정 (현재 private).
data/raw/

# ============================================
# WITNESS Drama Mining (Track A, 2026-05-12+)
# ============================================
# AI-Hub 023 방송 콘텐츠 대본 요약 데이터 — raw 절대 commit 금지 (재배포 금지).
# 학습 모델 / checkpoint / 전처리 산출 / split 메타 모두 local-only.
# 예외: docs/data_card.md, docs/model_cards/, docs/results/ 만 tracked.
data/aihub_023/
data/023.방송 콘텐츠 대본 요약 데이터/
data/processed/
data/splits/

# Model artifacts (binary, large)
*.pt
*.safetensors
*.bin
*.ckpt
checkpoints/

# Jupyter notebook output cache + cluster lock files
.ipynb_checkpoints/

# === 2026-05-15: AI-Hub 023 raw passage 보호 (라이선스: 재배포 금지) ===
docs/results/
tests/fixtures/aihub_023_sample.zip
