# ============================================
# 베드로 시뮬레이터 .gitignore
# ============================================

# Claude Code
CLAUDE.local.md
.claude-cache/
.claude-temp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 환경 변수
.env
.env.local
.env.*.local

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# 테스트 & 커버리지
coverage/
htmlcov/
*.lcov

# 로그 & 임시
logs/
*.log
tmp/
temp/

# 보안
*.pem
*.key
credentials.json
secrets.json
*.secrets
.secrets/
api-keys.json

# 실험 코드 (Probe 완료 후 삭제하지만 만약을 위해)
# experiments/ 는 커밋 가능 (Probe 진행 중일 수 있음)

# 빌드
dist/
build/

# Witness 생성 파일
*.db
*.sqlite
.coverage
coverage.xml
output/
.claude/scheduled_tasks.lock

# 대용량 생성 데이터 — reproducible 이므로 repo 미포함
# (필요 시 scripts/ 로 재생성). ABC snapshots(.db) / trajectory jsonl /
# numpy array(X.npy etc) 는 전부 실험 생성물.
# git 구문: data/* 로 내용은 제외, README.md/.gitkeep 만 예외.
data/*
!data/README.md
!data/.gitkeep

# 벤치마크 아티팩트 (소스는 OK, 결과는 제외)
benchmarks/results/
*.prof

# Backup / 임시 저장
*.bak
*.orig

# 실측 산출물 중 대용량은 제외 (구조/코드만 커밋)
# 단 docs/person/v3_measurement/*.json 은 유지 (rubric 비교 소스)
